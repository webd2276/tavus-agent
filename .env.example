# Tavus server credentials and the public-site default PAL.
TAVUS_API_KEY=your_tavus_api_key
TAVUS_PAL_ID=your_default_pal_id
TAVUS_FACE_ID=
TAVUS_CALLBACK_URL=https://your-domain.example/api/webhooks/tavus

# n8n webhook forwarding.
N8N_WEBHOOK_URL=https://your-n8n.example/webhook/tavus-lead
WEBHOOK_SHARED_SECRET=replace_with_a_long_random_secret

# Vapi browser voice calling (public client-side values).
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id

# Supabase project settings (safe to expose to the browser; never use the service-role key here).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
